        <mxCell id="planner" value="&lt;b&gt;02 · 粗粒度规划&lt;/b&gt;&lt;br&gt;&lt;br&gt;交互式 GPT 决定顺序与姿态&lt;br&gt;调用运动学工具辅助选点&lt;br&gt;人工审核粗关节路径" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#6186B1;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#20374C;spacing=12;arcSize=12;">
