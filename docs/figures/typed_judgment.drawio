        <mxCell id="validation" value="&lt;b&gt;2 · 确定性候选筛选&lt;/b&gt;&lt;br&gt;同基线 / 有界改动 / 重编译&lt;br&gt;默认几何检查；数值影子模式另标" parent="offline" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#BA994D;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#20374C;spacing=12;arcSize=12;">
          <mxGeometry as="geometry" x="500.0" y="40.0" width="360" height="125" />
        </mxCell>
        <mxCell id="provider" value="&lt;b&gt;3 · 可替换结构化判断&lt;/b&gt;&lt;br&gt;优先审核 / 补证据 / 新提案 / 拒判&lt;br&gt;禁用、合成、回放、可选 Jev API" parent="offline" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#9B7AB8;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#20374C;spacing=12;arcSize=12;">
