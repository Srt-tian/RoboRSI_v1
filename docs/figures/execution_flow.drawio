        <mxCell id="offline" value="&lt;b&gt;离线完成&lt;/b&gt;&lt;br&gt;编译 / dry 检查&lt;br&gt;可查看历史反馈，零硬件写入" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#A0ADBB;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#20374C;spacing=12;arcSize=12;">
